# Purchase Manager portal — frontend config.
# Point this at the STANDALONE Purchase Manager backend (same MongoDB, separate
# purchase_* collections). Leave unset in production only if the default in
# src/api/client.js already matches your deployed backend URL.
#
# Production (your deployed Purchase Manager backend):
VITE_API_URL=https://api-purchasemanager.tescomanagement.com/api
# Local dev (backend running via `npm start` in ../backend):
# VITE_API_URL=http://localhost:5003/api
